# ==============================================================================
# UBUNTU VOICE MONITOR - PLANTILLA DE CONFIGURACIÓN (.env)
# ==============================================================================
# Copia este archivo a .env (o a ~/.config/ubuntu-voice-monitor/config.env)
# y ajusta los valores según tu entorno.
# Las variables no definidas adoptarán sus valores predeterminados en el código.
# ==============================================================================

# --- [1] ENTORNO Y REGISTRO (APP & LOGGING) ---
# Entorno de ejecución: development, test, production
APP_ENV=development
# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- [2] RECOLECTORES DEL SISTEMA (COLLECTOR) ---
# Intervalo en segundos entre sondeos con alimentación por corriente continua
COLLECTOR_INTERVAL_S=5.0
# Intervalo en segundos durante uso de batería (debe ser >= COLLECTOR_INTERVAL_S)
COLLECTOR_BATTERY_INTERVAL_S=15.0
# Ajustar el intervalo de sondeo dinámicamente según la carga de trabajo detectada
COLLECTOR_ADAPTIVE=true

# --- [3] INTELIGENCIA ARTIFICIAL (GEMINI) ---
# Habilitar el análisis inteligente de eventos mediante Gemini en la nube
GEMINI_ENABLED=false
# Modelo de Google Gemini a utilizar
GEMINI_MODEL=gemini-2.5-flash
# Clave de API de Google AI Studio (https://aistudio.google.com/apikey). NUNCA publicarla en git.
GEMINI_API_KEY=

# --- [4] NARRACIÓN Y SALIDA DE VOZ (NARRATION) ---
# Nivel de detalle narrativo: minimal, normal, verbose
NARRATION_VERBOSITY=normal
# Segundos mínimos de silencio entre dos narraciones consecutivas
NARRATION_MIN_GAP_S=10.0
# Máximo de eventos narrados consecutivamente antes de pausar (token bucket)
NARRATION_MAX_BURST=3
# Tiempo de vida (TTL) en segundos de un evento antes de descartarse si no pudo narrarse
NARRATION_EVENT_TTL_S=60.0
# Ruta absoluta al modelo .onnx de Piper TTS (motor de voz primordial offline)
# Ejemplo: /home/usuario/.local/share/piper/es_ES-davefx-medium.onnx
NARRATION_PIPER_MODEL_PATH=

# --- [5] ALMACENAMIENTO Y PERSISTENCIA (STORAGE) ---
# Ruta del archivo de base de datos SQLite local (creada automáticamente si no existe)
STORAGE_DB_PATH=~/.local/share/ubuntu-voice-monitor/events.db

# --- [6] PRIVACIDAD Y SEGURIDAD (PRIVACY) ---
# Ocultar la ruta del directorio personal (/home/<usuario>) sustituyéndola por ~
PRIVACY_REDACT_HOME=true

# --- [7] MODO NO MOLESTAR (DND) ---
# Activar manualmente el modo No Molestar (silencia los altavoces sin descartar eventos)
DND_ENABLED=false
