# Copy this file to .env and adjust the values.
# The application reads these values from environment variables (or from .env).
# Variables left empty or missing fall back to their defaults.

# --- Application ---
# Runtime environment: development, test, production
APP_ENV=development
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Collector ---
# Seconds between readings while plugged in
COLLECTOR_INTERVAL_S=5
# Seconds between readings while on battery (must be >= COLLECTOR_INTERVAL_S)
COLLECTOR_BATTERY_INTERVAL_S=15
# Adapt the interval to system activity
COLLECTOR_ADAPTIVE=true

# --- Gemini ---
# Enable Gemini analysis (requires GEMINI_API_KEY)
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
# API key (https://aistudio.google.com/apikey). Never commit it.
GEMINI_API_KEY=

# --- Narration ---
# Verbosity: minimal, normal, verbose
NARRATION_VERBOSITY=normal
# Minimum seconds between two narrations
NARRATION_MIN_GAP_S=10
# Maximum consecutive narrations before pausing
NARRATION_MAX_BURST=3
# Seconds an event stays valid (must be >= NARRATION_MIN_GAP_S)
NARRATION_EVENT_TTL_S=60
# Absolute path to the Piper .onnx TTS model (optional, enables Piper offline TTS)
NARRATION_PIPER_MODEL_PATH=

# --- Privacy ---
# Hide the home directory in paths and texts
PRIVACY_REDACT_HOME=true
